# Distroless variant - no shell/package manager, smaller attack surface
# (most of the plain Dockerfile's OS-level CVEs come from tools this app
# never runs at all: perl, util-linux, login, mount, ...).
# Same build/runtime stages as ./Dockerfile otherwise - see that file for
# the reasoning behind --no-install-recommends + node-gyp.

# Base
FROM node:24.20.0-trixie-slim AS base

ENV PORT=8080

RUN corepack enable

WORKDIR /usr/src/app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./


# Production Deps
FROM base AS deps

ENV NODE_ENV=production

RUN apt-get update && \
    apt-get install -y --no-install-recommends node-gyp build-essential python3 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
RUN pnpm install --frozen-lockfile --prod


# Build
FROM base AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends node-gyp build-essential python3 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
RUN pnpm install --frozen-lockfile

COPY . ./
RUN pnpm run build


# Main
FROM gcr.io/distroless/nodejs24-debian13:nonroot

ENV NODE_ENV=production
# Preload OpenTelemetry auto-instrumentation before the app's own module
# graph loads (required for tracing to pick up http/express/pg/nest spans;
# see @fsarch/server/register). No-op unless tracing.enabled: true is set
# in config.yml.
ENV NODE_OPTIONS="--import @fsarch/server/register"
ENV PORT=8080

WORKDIR /usr/src/app

EXPOSE 8080

COPY --from=builder --chown=nonroot:nonroot /usr/src/app/dist ./dist
COPY --from=deps --chown=nonroot:nonroot /usr/src/app/node_modules ./node_modules

# distroless/nodejs's ENTRYPOINT is already the node binary - CMD is just
# its argv, no "node" prefix (and no USER - the :nonroot tag already runs
# as the built-in nonroot user). --experimental-vm-modules is still
# required here (function-executer uses vm.SourceTextModule to sandbox
# user function code), it's just passed as a plain node flag instead of
# following a "node" argv[0].
CMD ["--experimental-vm-modules", "./dist/main.js"]
